+
+# GC/1.2.5 inliner addresses (rayanht/mwcc config/GC_1_2_5/symbols.txt)
+CAN_INLINE_ADDR = 0x5125D0
+INLINE_PASS_ADDR = 0x582468
+CAN_INLINE_RETS = (0x512640, 0x51264E, 0x512663, 0x512677, 0x51267B, 0x512683)
+
+
+def run_inline_trace():
+    """Log every can_inline() verdict, grouped under the function codegen'd next."""
+    gdb.execute(f"break *{CAN_INLINE_ADDR:#x}")
+    for r in CAN_INLINE_RETS:
+        gdb.execute(f"break *{r:#x}")
+    gdb.execute(f"break *{MWCC_VERSION.codegen_start_addr:#x}")
+    pending = []
+    cur = None
+    out = open(os.path.join(OUTPUT_DIR, "inline_trace.txt"), "w")
+    while True:
+        try:
+            gdb.execute("continue")
+        except gdb.error:
+            break
+        pc = int(gdb.parse_and_eval("$pc"))
+        if pc == CAN_INLINE_ADDR:
+            sp = int(gdb.parse_and_eval("$esp"))
+            node = read_u32(sp + 4)
+            obj = read_u32(node + 0xA)
+            try:
+                callee = MwccObject.load(obj).name
+            except Exception:
+                callee = f"<obj {obj:#x}>"
+            info = read_u32(obj + 0x26)
+            extra = ""
+            if info:
+                ln = read_u32(obj + 0x2E)
+                lname = read_string(ln + 0xA) if ln else "?"
+                extra = f" [{lname} kind={read_u8(info + 0x28)} nstmts={read_u16(info + 0xC)}]"
+            cur = (read_s16(INLINE_PASS_ADDR), callee + extra)
+        elif pc in CAN_INLINE_RETS and cur:
+            ok = int(gdb.parse_and_eval("$eax")) & 0xFF
+            pending.append(f"  pass={cur[0]} {'INLINE' if ok else 'call  '} {cur[1]}")
+            cur = None
+        elif pc == MWCC_VERSION.codegen_start_addr:
+            func = find_current_function()
+            if FUNCTION_NAME in ("*", func.linkname):
+                out.write(f"{func.linkname}\n" + "\n".join(pending) + "\n\n")
+                out.flush()
+                if FUNCTION_NAME != "*":
+                    break
+            pending = []
+    out.close()
+
